  "cssProposal": "/* Asset 05 A1: static design overlay only, injected for mock-ups. */\n#btns .ui150-label, #restL, #atkL, #mmn, #cr.c193 .rail button small {\n font-family:Itim,system-ui,sans-serif!important;font-weight:400!important;\n color:#FFF3DB!important;line-height:1.5!important;letter-spacing:0!important;\n -webkit-text-stroke:1.5px #1B1330;paint-order:stroke fill;\n text-shadow:0 1px 2px #1B1330;overflow:visible!important;\n white-space:nowrap;flex-shrink:0;\n}\n#btns .ui150-label {font-size:13px!important;max-width:46px;margin:0!important;}\n#btns button, body.thumbs #btns button {width:56px;min-width:56px;height:56px;min-height:56px;padding:4px;gap:2px;}\n#btns, body.thumbs #btns {gap:6px;}\n#btns img.pxi,body.thumbs #btns img.pxi {width:24px;height:24px;}\n#bRest #restL {font-size:13px!important;max-width:48px;margin-top:1px!important;}\n#act #bRest,body.thumbs #act #bRest {width:56px!important;height:56px!important;font-size:21px!important;line-height:1!important;}\n#hud #xpT {font:700 18px/1.35 system-ui,sans-serif!important;color:#FFF3DB!important;\n right:6px!important;top:0!important;max-width:calc(100% - 12px);white-space:nowrap;\n font-variant-numeric:tabular-nums;text-shadow:0 1px 2px #1B1330;\n -webkit-text-stroke:1.5px #1B1330;paint-order:stroke fill;}\n#hud #xpw {height:26px!important;min-height:26px;margin-top:5px;}\nbody.thumbs.sys175 #lampBar {top:calc(130px + env(safe-area-inset-top,0px))!important;}\nbody.thumbs:not(.sys175) #lampBar {top:calc(116px + env(safe-area-inset-top,0px))!important;}\n#cr.c193 .rail {gap:6px!important;}\n#cr.c193 .rail button {width:56px!important;height:56px!important;min-width:56px!important;min-height:56px!important;flex-shrink:0;gap:1px;background:#2C213D!important;border-color:#BDA06A!important;color:#FFF3DB!important;opacity:1!important;}\n#cr.c193 .rail button.on {background:#4B355F!important;border-color:#FFD27A!important;box-shadow:0 0 0 2px #FFD27A55,0 3px 8px #0007!important;}\n#cr.c193 .rail button small {font-size:13px!important;max-width:48px!important;margin-top:0!important;}\n#cr.c193 .rail button.dim small {color:#D5CBB7!important;}\n#atkL {font-size:14px!important;max-width:70px!important;margin-top:2px;}\n#mmn {font-size:13px!important;max-width:144px!important;width:144px;white-space:normal;overflow-wrap:break-word;text-align:center;}\n#mmw {min-width:156px;gap:4px!important;}\n@media (min-height:600px) {\n #btns .ui150-label,#bRest #restL,#cr.c193 .rail button small,#mmn {font-size:14px!important;}\n #btns button,body.thumbs #btns button {width:60px;min-width:60px;height:60px;min-height:60px;}\n #btns .ui150-label {max-width:50px;}\n #act #bRest,body.thumbs #act #bRest {width:60px!important;height:60px!important;}\n #cr.c193 .rail button {width:60px!important;height:60px!important;min-width:60px!important;min-height:60px!important;}\n #cr.c193 .rail button small {max-width:52px!important;}\n #hud #xpT {font-size:20px!important;}\n #hud #xpw {height:29px!important;min-height:29px;}\n #atkL {font-size:15px!important;}\n}\n",
