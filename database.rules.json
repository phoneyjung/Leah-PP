{
  "rules": {
    "rooms": {
      "$room": {
        ".read": "auth != null",
        "players": {
          "$uid": {
            ".write": "auth != null && auth.uid === $uid",
            ".validate": "!newData.exists() || (newData.hasChildren(['n','m','x','y']) && newData.child('n').isString() && newData.child('n').val().length <= 12)"
          }
        },
        "emotes": {
          "$id": {
            ".write": "auth != null && (!data.exists() || (!newData.exists() && data.child('t').val() < now - 30000))",
            ".validate": "!newData.exists() || (newData.child('u').val() === auth.uid && newData.child('e').isString() && newData.child('e').val().length <= 4)"
          },
          ".indexOn": [
            "t"
          ]
        },
        "points": {
          "$house": {
            ".write": "auth != null",
            ".validate": "newData.isNumber() && ((!data.exists() && newData.val() <= 20) || (newData.val() >= data.val() && newData.val() <= data.val() + 20))"
          }
        },
        "maps": {
          "$map": {
            "mons": {
              ".write": "auth != null"
            },
            "hits": {
              ".write": "auth != null && !newData.exists()",
              "$id": {
                ".write": "auth != null && (!data.exists() || (!newData.exists() && data.child('t').val() < now - 30000))",
                ".validate": "!newData.exists() || (newData.child('u').val() === auth.uid && newData.child('d').isNumber() && newData.child('d').val() <= 500)"
              },
              ".indexOn": [
                "t"
              ]
            },
            "dmg": {
              ".write": "auth != null && !newData.exists()",
              "$id": {
                ".write": "auth != null && (!data.exists() || (!newData.exists() && data.child('t').val() < now - 30000))",
                ".validate": "!newData.exists() || (newData.child('n').isNumber() && newData.child('n').val() <= 200)"
              },
              ".indexOn": [
                "t"
              ]
            },
            "fx": {
              ".write": "auth != null && !newData.exists()",
              "$id": {
                ".write": "auth != null && (!data.exists() || (!newData.exists() && data.child('t').val() < now - 30000))"
              },
              ".indexOn": [
                "t"
              ]
            }
          }
        },
        "homes": {
          "$uid": {
            ".write": "auth != null && auth.uid === $uid",
            ".validate": "!newData.exists() || newData.hasChildren(['lv'])"
          }
        },
        "knock": {
          "$uid": {
            "$id": {
              ".write": "auth != null && (!data.exists() || (!newData.exists() && auth.uid === $uid))",
              ".validate": "!newData.exists() || (newData.child('n').isString() && newData.child('n').val().length <= 12)"
            },
            ".indexOn": [
              "t"
            ]
          }
        }
      }
    }
  }
}