> <script>
> // FPS meter for the real phone (this published copy only, not in the repo page): same idea as test G11 / plan G2.5 #9
> // tap -> walk SE in the cave, power 100, Glow+C on, 3 s per phase: lantern off / on x 3 pairs -> median FPS and on/off %
> (function(){const box=document.getElementById('fpsbox');let n=0,t0=performance.now(),cur='–',busy=false,res='';
>  function tick(){n++;const now=performance.now();if(now-t0>=1000){cur=Math.round(n*1000/(now-t0));n=0;t0=now;if(!busy)box.innerHTML='FPS '+cur+'<br>'+(res||'กดเพื่อวัด 18 วิ')}requestAnimationFrame(tick)}requestAnimationFrame(tick);
>  const wait=ms=>new Promise(r=>setTimeout(r,ms));
>  const count=ms=>new Promise(r=>{let k=0;const a=performance.now();const f=()=>{k++;const b=performance.now();if(b-a<ms)requestAnimationFrame(f);else r(k*1000/(b-a))};requestAnimationFrame(f)});
>  box.onclick=async()=>{if(busy||!window.PT)return;busy=true;box.classList.add('run');const off=[],on=[];
>   try{for(let i=0;i<6;i++){const h=i%2===1;box.innerHTML='กำลังวัด '+(i+1)+'/6<br>'+(h?'เปิดตะเกียง':'ปิดตะเกียง')+' · อย่าแตะจอ';
>     PT.set({scene:'cave',power:100,fx:true,hold:h,lpos:null,ldir:null,pos:{x:160,y:120},zoom:1});PT.pause(false);PT.walk('SE');await wait(500);(h?on:off).push(await count(3000));PT.stop()}
>    const med=v=>v.slice().sort((a,b)=>a-b)[1],a=med(off),b=med(on),pct=Math.round(b/a*1000)/10;
>    res='ปิด '+a.toFixed(1)+' · เปิด '+b.toFixed(1)+'<br>= '+pct+'% '+(pct>=90?'ผ่าน (≥ 90%)':'ต่ำกว่า 90%');
>   }catch(e){res='วัดไม่สำเร็จ'}
>   PT.set({hold:true,pos:{x:160,y:120},lpos:null,ldir:null});busy=false;box.classList.remove('run');box.innerHTML='FPS '+cur+'<br>'+res};
> })();
> </script>
